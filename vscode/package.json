{
  "name": "baker",
  "displayName": "Baker",
  "description": "Baker data files: diagnostics, hover, completion and go-to-definition from Baker itself",
  "version": "0.1.0",
  "publisher": "baker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zach/baker-editor"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "workspaceContains:**/baker-project.dta"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "baker",
        "aliases": [
          "Baker",
          "baker"
        ],
        "filenames": [
          "baker-project.dta"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "baker",
        "scopeName": "source.baker",
        "path": "./syntaxes/baker.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Baker",
      "properties": {
        "baker.server.path": {
          "type": "string",
          "default": "",
          "description": "The baker-lsp binary. Empty: the one bundled in the extension's server/ directory, else baker-lsp on the PATH."
        },
        "baker.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments for baker-lsp, such as [\"--reference\", \"build/reference.json\"] for a project whose project file names no reference."
        },
        "baker.console.port": {
          "type": "number",
          "default": 4555,
          "minimum": 0,
          "maximum": 65535,
          "description": "The running game's console on 127.0.0.1, for live values in hover and \"Write the live value here\". 0: none."
        },
        "baker.live.inlays": {
          "type": "boolean",
          "default": false,
          "description": "Show the running game's value beside each value a live edit in the game has changed, as an inlay hint."
        }
      }
    },
    "commands": [
      {
        "command": "baker.restartServer",
        "title": "Baker: Restart the language server"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p . --noEmit && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 && esbuild src/project.ts --outfile=out/project.js --format=cjs --platform=node",
    "test": "node test/grammar.test.js && node test/project.test.js",
    "package": "vsce package --no-dependencies",
    "bundle-server": "node -e \"const fs=require('fs'),p=require('path');const exe=process.platform==='win32'?'baker-lsp.exe':'baker-lsp';fs.mkdirSync('server',{recursive:true});fs.copyFileSync(p.join(process.argv[1]||'../build/server',exe),p.join('server',exe));fs.chmodSync(p.join('server',exe),0o755)\""
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "3.2.1",
    "typescript": "5.6.3",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.1.0",
    "esbuild": "0.23.1"
  }
}
